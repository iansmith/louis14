package layout

import (
	"testing"

	"louis14/pkg/css"
	"louis14/pkg/html"
	"louis14/pkg/text"
)

// TestCrossSpanKerningHonorsFontKerningNone — LOU-359 Category D2
// (BLOCKED-ON-COORDINATOR: fix requires editing pkg/layout/line_breaker.go,
// owned by an in-flight PR).
//
// CSS Fonts 4 §6.2: `font-kerning: none` disables the OpenType `kern`
// feature. The LineBreaker's cross-span shaping merge (applyCrossSpanKerning,
// line_breaker.go) re-shapes adjacent same-context text items as one run and
// slices per-item advances — deliberately recovering cross-item kern pairs.
// When the style disables kerning, that merge must NOT apply kerned advances:
// Blink's HarfBuzzShaper receives the font-description's feature list and
// shapes with `kern` disabled (FontDescription::GetFontKerning →
// CreateFontFeatures; mazzy's textshape.ShapingParams.Features is the
// louis14-side carrier). WPT first-letter-opacity-float-001.html disables
// kerning precisely so the float-side (unmergeable) and inline-side
// (mergeable) advances agree; the P·A kern pair otherwise shifts the
// reference by ~1.47px @16px Liberation Serif.
//
// RED until line_breaker.go either skips the merge or shapes with kern off
// when the measuring style has font-kerning:none / font-feature-settings
// "kern" off.
func TestCrossSpanKerningHonorsFontKerningNone(t *testing.T) {
	div := &html.Node{Type: html.ElementNode, TagName: "div"}
	span := &html.Node{Type: html.ElementNode, TagName: "span", Parent: div}
	pText := &html.Node{Type: html.TextNode, Text: "P", Parent: span}
	span.Children = []*html.Node{pText}
	assText := &html.Node{Type: html.TextNode, Text: "ASS", Parent: div}
	div.Children = []*html.Node{span, assText}

	divStyle := makeStyle("display", "block", "font-kerning", "none")
	spanStyle := makeStyle("display", "inline", "font-kerning", "none")
	styles := map[*html.Node]*css.Style{div: divStyle, span: spanStyle}

	layoutParent := buildTestTree(div, styles)
	itemsData := CollectInlines(layoutParent)
	if len(itemsData.Items) == 0 {
		t.Fatal("no inline items collected")
	}

	ctx := testContext()
	fonts := text.DefaultFontConfig()
	wdm := WritingDirectionMode{WritingModeHorizontalTB, DirectionLTR}
	space := ConstraintSpace{
		AvailableSize:    oldLogicalToGeom(LogicalSize{InlineSize: 800, BlockSize: Indefinite}),
		WritingDirection: wdm,
	}
	lb := NewLineBreaker(itemsData, ctx, space, fonts, LineBreakerContent)
	lb.availableWidth = 800

	var line LineInfo
	if !lb.NextLine(&line) {
		t.Fatal("no line produced")
	}

	// The standalone advance of "P" with kerning disabled.
	fontPath := resolveFontPath(spanStyle, fonts)
	wantP, _ := text.MeasureText("P", 16, fontPath)

	found := false
	for i := range line.Results {
		r := &line.Results[i]
		if r.Item.Type != InlineItemText {
			continue
		}
		content := itemsData.TextContent[r.TextStart:r.TextEnd]
		if content != "P" {
			continue
		}
		found = true
		if r.InlineSize != wantP.Float64() {
			t.Errorf("font-kerning:none span 'P' advance = %v, want standalone advance %v (cross-span kern pair must not apply)",
				r.InlineSize, wantP.Float64())
		}
	}
	if !found {
		t.Fatal("no 'P' text item found on the line")
	}
}
