<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <title>CSS Test: text-indent on first line of block</title>
  <link rel="match" href="text-indent-001-ref.xht" />
  <meta name="assert" content="text-indent indents the first line of a block container" />
  <style type="text/css">
    body { margin: 0; }
    .test {
      width: 200px;
      text-indent: 50px;
    }
    .box {
      display: inline-block;
      width: 50px;
      height: 50px;
      background: green;
    }
  </style>
</head>
<body>
  <div class="test"><span class="box"></span></div>
</body>
</html>
