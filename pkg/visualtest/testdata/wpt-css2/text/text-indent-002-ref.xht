<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <title>CSS Test Reference</title>
  <style type="text/css">
    body { margin: 0; }
    .box {
      display: inline-block;
      width: 100px;
      height: 50px;
      background: green;
    }
  </style>
</head>
<body>
  <!-- First line: box at X=100. Second line: box at X=0 -->
  <div style="width: 200px;"><span class="box" style="margin-left: 100px;"></span></div>
  <div style="width: 200px;"><span class="box"></span></div>
</body>
</html>
