<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <title>CSS Test: text-indent only applies to first line</title>
  <link rel="match" href="text-indent-002-ref.xht" />
  <meta name="assert" content="text-indent only applies to the first formatted line of a block container, not subsequent lines" />
  <style type="text/css">
    body { margin: 0; }
    .test {
      width: 200px;
      text-indent: 100px;
    }
    .box {
      display: inline-block;
      width: 100px;
      height: 50px;
      background: green;
    }
  </style>
</head>
<body>
  <!-- First box indented by 100px, fills to 200px. Second box wraps to next line at X=0 -->
  <div class="test"><span class="box"></span><span class="box"></span></div>
</body>
</html>
