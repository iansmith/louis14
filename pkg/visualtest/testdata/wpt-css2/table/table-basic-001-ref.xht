<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Strict//EN" "http://www.w3.org/TR/xhtml1/DTD/xhtml1-strict.dtd">
<html xmlns="http://www.w3.org/1999/xhtml">
<head>
  <title>CSS Test Reference</title>
  <style type="text/css">
    body { margin: 0; }
    .row { height: 50px; }
    .cell { display: inline-block; width: 50px; height: 50px; }
    .g { background: green; }
    .b { background: blue; }
  </style>
</head>
<body>
  <div class="row"><span class="cell g"></span><span class="cell b"></span></div>
  <div class="row"><span class="cell b"></span><span class="cell g"></span></div>
</body>
</html>
