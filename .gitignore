# Claude Code
.claude/
.project-prefix

# Local working copy of mazarin/textshape (cross-repo change staging)
.local-mazarin/

# Root-level markdown — personal notes, scratch work, ticket-local prompts.
# Ticket-local files belong in .slopstop/ticket-active/<TICKET>/; design docs
# belong in design/. CLAUDE.md is the one tracked exception.
/*.md
!/CLAUDE.md
# Mirrored universal rules, imported by CLAUDE.md. Must be tracked — a trailing
# comment here would NOT be a comment (.gitignore only honours # at line start)
# and would silently make this negation match nothing.
!/CLAUDE-universal.md

# Personal scratch / drafts — design docs go to design/ (tracked). Formerly /docs/.
/scratch/

# slopstop project-local ticket tracking (transient working state, not source)
.slopstop/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
l14open
l14show

